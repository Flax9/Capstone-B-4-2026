# ========================================================
# TEMPLATE KONEKSI KE DATABASE MITRA (EXTERNAL POSTGRESQL)
# ========================================================
# Jika API Docker ini diinstal di server (Production/Staging) dan ingin 
# "menembak" ke server PostgreSQL fisik milik Mitra yang berbeda lokasi, gunakan format ini.

# 1. DATABASE UTAMA (MASTER/READ-WRITE)
# Ganti `198.51.100.24` dengan IP Publik / Domain server Mitra Anda.
# Ganti `5432` dengan port PostgreSQL mereka (jika dikustom).
# Ganti `capstonev2` dengan nama database utama mereka.
DB_MASTER_URL=jdbc:postgresql://198.51.100.24:5432/capstonev2
DB_MASTER_USER=admin_mitra
DB_MASTER_PASS=rahasia_mitra_123

# 2. DATABASE REPLIKA (READ ONLY)
# Bila Mitra Anda memiliki 2 server terpisah (Kluster), isikan IP Server ke-2 di sini.
# Bila Mitra *TIDAK* punya arsitektur replika (hanya punya 1 server DB tunggal), 
# cukup COPY-PASTE persis nilai DB_MASTER ke bawah ini agar tidak ada error.
DB_REPLICA_URL=jdbc:postgresql://198.51.100.25:5432/capstonev2-replica
DB_REPLICA_USER=admin_mitra_readonly
DB_REPLICA_PASS=rahasia_mitra_123

# ========================================================
# KONFIGURASI APLIKASI LAINNYA UNTUK PRODUCTION
# ========================================================
# Spring Boot Active Profile (merubah log, format trace, dll)
APP_PROFILE=production

# Konfigurasi Koneksi Redis Eksternal milik mitra (bila ada)
#REDIS_HOST=10.0.5.99
#REDIS_PORT=6379
