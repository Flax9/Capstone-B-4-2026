# Database Configuration
# Connect these to your existing local PostgreSQL instance
# (For local dev, usually the Master and Replica can point to the same database if you don't actually have a replica running locally)

DB_MASTER_URL=jdbc:postgresql://host.docker.internal:5432/capstonev2
DB_MASTER_USER=postgres
DB_MASTER_PASS=purqon

DB_REPLICA_URL=jdbc:postgresql://host.docker.internal:5432/capstonev2
DB_REPLICA_USER=postgres
DB_REPLICA_PASS=purqon  

# Redis Configuration
#REDIS_HOST=127.0.0.1
#REDIS_PORT=6379
